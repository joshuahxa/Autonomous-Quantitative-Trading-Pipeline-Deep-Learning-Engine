def send_push(message):
    try: requests.get(f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage?chat_id={TELEGRAM_CHAT_ID}&text={message}")
    except: pass

class TradingLSTM(nn.Module):
    def __init__(self, input_size=5, hidden_layer_size=64, output_size=1):
        super().__init__()
        self.lstm = nn.LSTM(input_size, hidden_layer_size, batch_first=True)
        self.linear = nn.Linear(hidden_layer_size, output_size)
        self.sigmoid = nn.Sigmoid()

    def forward(self, input_seq):
        lstm_out, _ = self.lstm(input_seq)
        return self.sigmoid(self.linear(lstm_out[:, -1, :]))

model = TradingLSTM(input_size=5)
model.load_state_dict(torch.load(r"C:\Users\joshu\Downloads\trade_brain.pth", weights_only=True))
model.eval()

# --- THE MACRO FILTER ---
vix_df = yf.Ticker("^VIX").history(period="5d")
